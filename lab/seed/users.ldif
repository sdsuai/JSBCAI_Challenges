objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: carol
cn: Carol Adeyemi
sn: Adeyemi
mail: carol@jsbcai.lab
uidNumber: 10003
gidNumber: 20002
homeDirectory: /srv/lab/home/carol
loginShell: /bin/bash
userPassword: {SSHA}W4lEdxCJoy9O58XAZuSZK/pj2g9qc2JjYWkwMQ==

